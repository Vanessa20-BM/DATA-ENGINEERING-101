Table Departments{
  department_id int [pk, increment]
  name varchar(100) [not null, unique]
  building varchar(50) 
  created_at timestamp [default: 'now()'] 

}

Table Students{
  student_id int [pk,increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(50) [not null,  unique]
  date_of_birth date 
  phone_num varchar(20)
  enrolment_date date [default: 'now()']
  department_id int [not null, ref: > Departments.department_id]
  is_active boolean [default: true]
  created_at timestamp [default: 'now()']
}

Table Instructors{
  instructor_id int [pk, increment]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(50) [not null,  unique]
  date_of_birth date 
  phone_num varchar(20)
  hire_date date [default: 'now()']
  department_id int [not null, ref: > Departments.department_id]
  salary decimal(10,2)

}

Table Courses{
  course_id int [pk, increment]
  course_code varchar(20) [not null, unique]
  course_name varchar(50) [not null]
  credits int
  description text
  department_id int [not null, ref: > Departments.department_id]
  created_at timestamp [default: 'now()']
}

Table Classes{
  class_id int [pk, increment]
  course_id int [not null, ref: > Courses.course_id ]
  instructor_id int [not null, ref: > Instructors.instructor_id]
  start_time time [not null]
  end_time time [not null]
  semester varchar(20)
  year int [not null]
  total_students int [not null]
  created_at timestamp [default: 'now()']
}

Table Enrollments{
  enroll_id int [pk , increment]
  student_id int [not null, ref: > Students.student_id]
  course_id int [not null, ref: > Courses.course_id]
  enroll_date date [not null, default: 'now()']
  level int
  created_at timestamp [default: 'now()']
}